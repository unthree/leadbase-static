# --- AI provider (any OpenAI-compatible API) ---
# Your OpenAI API key (or the key for whatever compatible gateway you use)
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible API. Change this if you route through a
# proxy/gateway that serves your custom models.
OPENAI_BASE_URL=https://api.openai.com/v1

# Primary model used for drafting/research. Set this to the exact model id
# your provider exposes (e.g. "gpt-5.6-sol" if your gateway serves it).
OPENAI_MODEL=gpt-5.6-sol

# Agent model used for multi-step "agent" style jobs (e.g. "hermes-agent").
HERMES_MODEL=hermes-agent

# --- Newsletter delivery (optional) ---
RESEND_API_KEY=
NEWSLETTER_EMAIL_TO=
